# Copy this file to .env.local (git-ignored) to point the frontend at a
# real trained model instead of the built-in mock generator.
#
# 1. Download best.pt from your Kaggle training notebook's Output tab.
# 2. From training/, with the venv active:
#      pip install -r requirements.txt
#      python -m src.server --checkpoint /path/to/ECNet-7.pt
# 3. Uncomment the two lines below, restart the Vite dev server (npm run dev).

# VITE_USE_REAL_BACKEND=true
# VITE_BACKEND_URL=http://localhost:8000
